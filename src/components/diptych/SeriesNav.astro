---
/**
 * SeriesNav — prev/next navigation for series entries.
 * Shows arrows with "part i" / "part iii" labels.
 * Series title centered between.
 */

interface SeriesSibling {
  slug: string;
  title: string;
  partIndex: number;
}

interface Props {
  seriesTitle: string;
  prev?: SeriesSibling;
  next?: SeriesSibling;
}

const { seriesTitle, prev, next } = Astro.props;

// Convert to roman numerals
const toRoman = (n: number): string => {
  const romans: [number, string][] = [
    [10, 'x'], [9, 'ix'], [5, 'v'], [4, 'iv'], [1, 'i']
  ];
  let result = '';
  for (const [value, numeral] of romans) {
    while (n >= value) {
      result += numeral;
      n -= value;
    }
  }
  return result;
};
---

<nav class="series-nav" aria-label="Series navigation">
  <div class="series-nav-prev">
    {prev ? (
      <a href={`/cuaderno/${prev.slug}/`}>
        <span class="arrow">←</span>
        <span class="label">part {toRoman(prev.partIndex)}</span>
      </a>
    ) : (
      <span class="placeholder"></span>
    )}
  </div>

  <div class="series-nav-title">
    <span class="series-label">{seriesTitle}</span>
  </div>

  <div class="series-nav-next">
    {next ? (
      <a href={`/cuaderno/${next.slug}/`}>
        <span class="label">part {toRoman(next.partIndex)}</span>
        <span class="arrow">→</span>
      </a>
    ) : (
      <span class="placeholder"></span>
    )}
  </div>
</nav>

<style>
  .series-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--rhythm);
    margin-top: var(--rhythm-lg);
    padding-top: var(--rhythm);
    border-top: 1px solid var(--paper-line);
  }

  .series-nav-prev,
  .series-nav-next {
    flex: 1;
    min-width: 0;
  }

  .series-nav-prev {
    text-align: left;
  }

  .series-nav-next {
    text-align: right;
  }

  .series-nav-title {
    flex: 2;
    text-align: center;
    min-width: 0;
  }

  .series-label {
    font-family: var(--font-serif);
    font-size: 0.722rem;
    font-style: italic;
    color: var(--ink-faint);
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-nav a {
    font-family: var(--font-mono);
    font-size: 0.667rem;
    color: var(--ink-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 4px 8px;
    margin: -4px -8px;
    border-radius: 2px;
    transition: color 0.15s ease;
  }

  .series-nav a:hover {
    color: var(--terracotta);
  }

  .series-nav a:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 2px;
  }

  .arrow {
    font-size: 0.778rem;
  }

  .label {
    letter-spacing: 0.03em;
  }

  .placeholder {
    display: block;
    min-height: 1em;
  }

  @media (max-width: 500px) {
    .series-nav {
      flex-direction: column;
      gap: var(--rhythm-sm);
    }

    .series-nav-prev,
    .series-nav-next,
    .series-nav-title {
      width: 100%;
      text-align: center;
    }

    .series-nav-title {
      order: -1;
    }
  }
</style>
