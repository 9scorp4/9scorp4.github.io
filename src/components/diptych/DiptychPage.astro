---
/**
 * DiptychPage — main layout wrapper for diptych journal entries.
 * Renders: Header → Article → Seam → Metalogue → Colophon → Return Marker
 */

import type { CollectionEntry } from 'astro:content';
import Garden from '../../layouts/Garden.astro';
import DiptychHeader from './DiptychHeader.astro';
import DiptychNav from './DiptychNav.astro';
import Seam from './Seam.astro';
import MetalogueBody from './MetalogueBody.astro';
import DiptychColophon from './DiptychColophon.astro';
import ReturnMarker from './ReturnMarker.astro';

interface Props {
  entry: CollectionEntry<'journal'>;
  articleHtml: string;
  metalogueHtml: string;
}

const { entry, articleHtml, metalogueHtml } = Astro.props;
const { title, title_secondary, date, entry: entryNumber, preamble, metalogue_title, metalogue_epigraph, colophon, summary } = entry.data;
const workerUrl = import.meta.env.PUBLIC_VISITORS_WORKER_URL || '';
const slug = entry.slug;

const pageTitle = `${title}${title_secondary ? ` · ${title_secondary}` : ''} — un jardín cibernético`;
const canonicalUrl = `/cuaderno/${entry.slug}/`;

// JSON-LD structured data
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title + (title_secondary ? ` · ${title_secondary}` : ''),
  "datePublished": date.toISOString(),
  "description": summary,
  "author": {
    "@type": "Person",
    "name": "Nico"
  },
  "publisher": {
    "@type": "Person",
    "name": "Nico"
  }
});
---

<Garden
  title={pageTitle}
  description={summary}
  ogType="article"
  ogImageSlug={entry.slug}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={jsonLd} />
  <main id="main" class="diptych">
    <article class="diptych-article">
      <DiptychHeader
        title={title}
        title_secondary={title_secondary}
        date={date}
        entry={entryNumber}
        preamble={preamble}
      />

      <div class="article-body" id="article" set:html={articleHtml} />

      <Seam />

      <MetalogueBody
        id="metalogue"
        title={metalogue_title || 'metalogue'}
        epigraph={metalogue_epigraph}
      >
        <Fragment set:html={metalogueHtml} />
      </MetalogueBody>

      {colophon && <DiptychColophon text={colophon} />}

      <ReturnMarker />
    </article>
    <DiptychNav />
  </main>
</Garden>

<style>
  .diptych {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--rhythm-lg);
  }

  .diptych-article {
    max-width: 700px;
    margin: 0 auto;
  }

  /* Article body prose styles */
  .article-body {
    max-width: 650px;
    margin: 0 auto;
  }

  .article-body :global(p) {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.75;
    margin-bottom: var(--rhythm);
    color: var(--ink);
  }

  .article-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Horizontal rules as section breaks */
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--paper-line);
    margin: var(--rhythm-lg) auto;
    max-width: 100px;
  }

  /* Emphasis */
  .article-body :global(em) {
    font-style: italic;
  }

  .article-body :global(strong) {
    font-weight: 600;
  }

  /* Links */
  .article-body :global(a) {
    color: var(--fern);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 640px) {
    .diptych {
      padding: var(--rhythm);
    }

    .article-body :global(p),
    .diptych :global(.metalogue-content p) {
      font-size: 16px;
    }
  }
</style>

<script define:vars={{ workerUrl, slug }}>
  // Article read tracking for diptych entries
  (function() {
    if (!workerUrl || navigator.doNotTrack === '1') return;

    const startTime = Date.now();
    let maxScrollDepth = 0;
    let tracked = false;

    // Track scroll depth
    function updateScrollDepth() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight > 0) {
        const depth = Math.round((scrollTop / docHeight) * 100);
        maxScrollDepth = Math.max(maxScrollDepth, depth);
      }
    }

    window.addEventListener('scroll', updateScrollDepth, { passive: true });
    updateScrollDepth(); // Initial

    // Track on visibility change or unload
    function trackRead() {
      if (tracked) return;
      const readTime = Math.round((Date.now() - startTime) / 1000);
      if (readTime < 10) return; // Only track if >10s spent
      tracked = true;

      try {
        navigator.sendBeacon?.(
          workerUrl + '/track',
          JSON.stringify({
            type: 'article_read',
            path: '/cuaderno/' + slug,
            readTime,
            scrollDepth: maxScrollDepth,
          })
        );

        // Also update local storage for garden stats
        const stored = localStorage.getItem('jardin-visitor');
        if (stored) {
          const state = JSON.parse(stored);
          if (state.stats && !state.stats.articlesRead.includes(slug)) {
            state.stats.articlesRead.push(slug);
            localStorage.setItem('jardin-visitor', JSON.stringify(state));
          }
        }
      } catch {
        // Silently fail
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        trackRead();
      }
    });

    // Fallback for page unload
    window.addEventListener('pagehide', trackRead);
  })();
</script>
