---
/**
 * ReturnMarker — trilingual back-to-top anchor.
 * Spanish (warmth) · French (place) · English (explanation)
 */
---

<nav class="return-marker" aria-label="Return to top">
  <a href="#top">↑ regresar · revenir · back to top</a>
  <a href="/#visitors-book" class="leave-note" id="leave-note-link">deja una nota →</a>
</nav>

<style>
  .return-marker {
    text-align: center;
    margin-top: var(--rhythm-lg);
    padding-top: var(--rhythm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .return-marker a {
    font-family: var(--font-serif);
    font-size: 14px;
    font-style: italic;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .return-marker a:hover {
    color: var(--terracotta);
  }

  .return-marker a:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 2px;
  }
</style>

<script>
  const link = document.getElementById('leave-note-link');
  link?.addEventListener('click', (e) => {
    const input = document.getElementById('console-input') as HTMLInputElement;
    const book = document.getElementById('visitors-book');

    // If not on main page, let the link navigate normally
    if (!input || !book) return;

    e.preventDefault();
    book.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Delay focus until scroll settles
    setTimeout(() => {
      const template = 'dejar nombre="" mensaje=""';
      input.value = template;
      input.focus();
      input.setSelectionRange(14, 14); // cursor inside nombre quotes

      // Trigger input event to update cursor and hide ghost text
      input.dispatchEvent(new Event('input'));
    }, 300);
  });
</script>
