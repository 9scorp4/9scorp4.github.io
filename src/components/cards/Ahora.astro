---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { getSeason } from '../../lib/season';
import { extractSlug } from '../../lib/journal-slug';
import AhoraEntryMeta from './AhoraEntryMeta.astro';

// Fetch collections for lookups
const journalEntries = await getCollection('journal');
const specimensData = await getCollection('specimens');
const cultivationsData = await getCollection('cultivations');

// Helper to get folder name from entry id (Astro v6: "01_lo-que-cruza/index" → "01_lo-que-cruza")
const getFolderName = (e: { id: string }) => e.id.replace(/\/index$/, '');

// Create lookup maps keyed by clean slug (for matching articuloNuevo)
const journalBySlug = new Map(journalEntries.map(e => [extractSlug(getFolderName(e)), e]));
// Also build slug→folder lookup for URL construction
const slugToFolder = new Map(journalEntries.map(e => {
  const folder = getFolderName(e);
  return [extractSlug(folder), folder];
}));
const specimensById = new Map(specimensData.map(s => [s.data.id, s]));
const cultivationsBySlug = new Map(cultivationsData.map(c => [c.data.slug, c]));

// Resolve entry metadata into props for AhoraEntryMeta component
function resolveEntryMeta(entry: CollectionEntry<'ahora'>) {
  return {
    escuchando: entry.data.escuchando,
    articulosNuevos: entry.data.articuloNuevo?.map(item => {
      const journal = journalBySlug.get(item.article);
      return journal ? {
        href: `/cuaderno/${slugToFolder.get(item.article) ?? item.article}`,
        title: journal.data.title,
        note: item.note
      } : null;
    }).filter((x): x is NonNullable<typeof x> => x !== null),
    specimensNuevos: entry.data.specimenNuevo?.map(item => {
      const specimen = specimensById.get(item.specimen);
      return specimen ? {
        href: `/#${item.specimen}`,
        name: specimen.data.name,
        note: item.note
      } : null;
    }).filter((x): x is NonNullable<typeof x> => x !== null),
    cultivando: entry.data.cultivando?.map(item => {
      const cultivation = cultivationsBySlug.get(item.cultivation);
      return cultivation ? {
        href: '/#cultivos',
        name: cultivation.data.name,
        note: item.note
      } : null;
    }).filter((x): x is NonNullable<typeof x> => x !== null)
  };
}

interface Props {
  entries: CollectionEntry<'ahora'>[];
  maxEntries?: number;
}

const { entries, maxEntries = 50 } = Astro.props;

// French month names (reuse pattern from JournalEntry)
const frenchMonths = [
  'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'
];

// Format date in French style: "4 mai" (using UTC to avoid timezone shifts)
function formatDate(date: Date): string {
  const day = date.getUTCDate();
  const month = frenchMonths[date.getUTCMonth()];
  return `${day} ${month}`;
}

// Seasonal empty state messages (uses canonical getSeason from src/lib/season.ts)
function getSeasonalMessage(): string {
  const season = getSeason(new Date().toISOString());
  switch (season) {
    case 'invierno': return 'waiting for spring.';
    case 'primavera': return 'el deshielo, por fin.';
    case 'verano': return 'el jardín está alto.';
    case 'otoño': return 'los días se acortan.';
  }
}

// Check if latest entry is stale (> 6 months old)
function isStale(latestDate: Date): boolean {
  const now = new Date();
  const sixMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 6, now.getDate());
  return latestDate < sixMonthsAgo;
}

// Limit entries
const displayEntries = entries.slice(0, maxEntries);
const latestEntry = displayEntries[0];
const olderEntries = displayEntries.slice(1);
const stale = latestEntry ? isStale(latestEntry.data.date) : false;

// Render content for entries
const renderedEntries = await Promise.all(
  displayEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const latestRendered = renderedEntries[0];
const olderRendered = renderedEntries.slice(1);

// Split older entries: first 3 visible, rest in collapsible archive
const visibleOlder = olderRendered.slice(0, 3);
const hiddenOlder = olderRendered.slice(3);
---

<div class="ahora">
  {displayEntries.length === 0 ? (
    <p class="empty-state">{getSeasonalMessage()}</p>
  ) : stale ? (
    <>
      <p class="seasonal-message">{getSeasonalMessage()}</p>
      <div class="archive dimmed">
        {renderedEntries.map(({ entry, Content }) => (
          <div class="ahora-entry older">
            <time class="date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
            <div class="body">
              <Content />
              <AhoraEntryMeta {...resolveEntryMeta(entry)} />
            </div>
          </div>
        ))}
      </div>
    </>
  ) : (
    <>
      <div class="ahora-entry latest">
        <p class="date"><time datetime={latestRendered.entry.data.date.toISOString().slice(0, 10)}>{formatDate(latestRendered.entry.data.date)}</time></p>
        <div class="body">
          <latestRendered.Content />
          <AhoraEntryMeta {...resolveEntryMeta(latestRendered.entry)} showMyceliumLink />
        </div>
      </div>
      {visibleOlder.length > 0 && (
        <div class="older-entries">
          {visibleOlder.map(({ entry, Content }) => (
            <div class="ahora-entry older">
              <time class="date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
              <div class="body">
                <Content />
                <AhoraEntryMeta {...resolveEntryMeta(entry)} />
              </div>
            </div>
          ))}
          {hiddenOlder.length > 0 && (
            <details class="ahora-archive">
              <summary class="archive-toggle">antes...</summary>
              <div class="archive-entries">
                {hiddenOlder.map(({ entry, Content }) => (
                  <div class="ahora-entry older">
                    <time class="date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
                    <div class="body">
                      <Content />
                      <AhoraEntryMeta {...resolveEntryMeta(entry)} />
                    </div>
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>
      )}
    </>
  )}
</div>

<style>
  .ahora {
    text-align: center;
  }

  .empty-state,
  .seasonal-message {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0;
  }

  .seasonal-message {
    margin-bottom: var(--rhythm);
  }

  .archive.dimmed {
    opacity: 0.6;
  }

  .ahora-entry {
    margin-bottom: var(--rhythm-sm);
  }

  .ahora-entry:last-child {
    margin-bottom: 0;
  }

  .ahora-entry.latest .date {
    font-family: var(--font-serif);
    font-size: 0.778rem;
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 var(--rhythm-sm) 0;
  }

  .ahora-entry.latest .body {
    font-family: var(--font-serif);
    font-size: 0.889rem;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-line;
  }

  .ahora-entry.older .date {
    font-family: var(--font-serif);
    font-size: 0.778rem;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0 0 var(--rhythm-sm) 0;
  }

  .ahora-entry.older .body {
    font-family: var(--font-serif);
    font-size: 0.833rem;
    color: var(--ink-faint);
    line-height: 1.5;
    white-space: pre-line;
  }

  .older-entries {
    margin-top: var(--rhythm);
    padding-top: var(--rhythm-sm);
    border-top: 1px solid var(--ink-faint);
  }

  .ahora-archive {
    margin-top: var(--rhythm-sm);
  }

  .archive-toggle {
    font-family: var(--font-serif);
    font-size: 0.778rem;
    font-style: italic;
    color: var(--ink-faint);
    cursor: pointer;
    list-style: none;
  }

  .archive-toggle::-webkit-details-marker {
    display: none;
  }

  .archive-toggle::marker {
    display: none;
    content: '';
  }

  .archive-toggle:hover {
    color: var(--ink-soft);
  }

  .archive-entries {
    margin-top: var(--rhythm-sm);
  }

  /* Markdown content styling */
  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 0.5em;
  }

  .body :global(em) {
    color: var(--ink-soft);
  }

  .body :global(a[href^="http"]) {
    white-space: nowrap;
    padding: 8px 4px;
    margin: -8px -4px;
    display: inline-block;
  }

  .body :global(a[href^="http"])::after {
    content: " ↗";
    font-size: 0.8em;
    opacity: 0.6;
  }

  .body :global(.mycelium-link) {
    color: var(--ink-faint);
    text-decoration: none;
    opacity: 0.6;
    font-size: 0.9em;
    transition: opacity 0.2s, color 0.2s;
  }

  .body :global(.mycelium-link:hover) {
    color: var(--fern);
    opacity: 1;
  }

  .body :global(.mycelium-link)::after {
    content: none;
  }

  /* Mobile: allow long links to wrap */
  @media (max-width: 480px) {
    .body :global(a[href^="http"]) {
      white-space: normal;
      word-break: break-word;
    }
  }
</style>
