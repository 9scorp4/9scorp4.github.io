---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { getSeason } from '../../lib/season';

// Fetch collections for lookups
const journalEntries = await getCollection('journal');
const specimensData = await getCollection('specimens');
const cultivationsData = await getCollection('cultivations');

// Create lookup maps (Astro v6: use id with folder/index pattern, extract slug)
const journalBySlug = new Map(journalEntries.map(e => [e.id.replace(/\/index$/, ''), e]));
const specimensById = new Map(specimensData.map(s => [s.data.id, s]));
const cultivationsBySlug = new Map(cultivationsData.map(c => [c.data.slug, c]));

interface Props {
  entries: CollectionEntry<'ahora'>[];
  maxEntries?: number;
}

const { entries, maxEntries = 5 } = Astro.props;

// French month names (reuse pattern from JournalEntry)
const frenchMonths = [
  'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'
];

// Format date in French style: "4 mai" (using UTC to avoid timezone shifts)
function formatDate(date: Date): string {
  const day = date.getUTCDate();
  const month = frenchMonths[date.getUTCMonth()];
  return `${day} ${month}`;
}

// Seasonal empty state messages (uses canonical getSeason from src/lib/season.ts)
function getSeasonalMessage(): string {
  const season = getSeason(new Date().toISOString());
  switch (season) {
    case 'invierno': return 'waiting for spring.';
    case 'primavera': return 'el deshielo, por fin.';
    case 'verano': return 'el jardín está alto.';
    case 'otoño': return 'los días se acortan.';
  }
}

// Check if latest entry is stale (> 6 months old)
function isStale(latestDate: Date): boolean {
  const now = new Date();
  const sixMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 6, now.getDate());
  return latestDate < sixMonthsAgo;
}

// Limit entries
const displayEntries = entries.slice(0, maxEntries);
const latestEntry = displayEntries[0];
const olderEntries = displayEntries.slice(1);
const stale = latestEntry ? isStale(latestEntry.data.date) : false;

// Render content for entries
const renderedEntries = await Promise.all(
  displayEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const latestRendered = renderedEntries[0];
const olderRendered = renderedEntries.slice(1);
---

<div class="ahora">
  {displayEntries.length === 0 ? (
    <p class="empty-state">{getSeasonalMessage()}</p>
  ) : stale ? (
    <>
      <p class="seasonal-message">{getSeasonalMessage()}</p>
      <div class="archive dimmed">
        {renderedEntries.map(({ entry, Content }) => (
          <div class="ahora-entry older">
            <time class="date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
            <div class="body">
              <Content />
              {entry.data.escuchando && entry.data.escuchando.length > 0 && (
                <p>
                  <em>escuchando:</em>{' '}
                  {entry.data.escuchando.map((track, i) => (
                    <>
                      <a href={track.url}>{track.artist} — {track.title}</a>
                      {i < entry.data.escuchando!.length - 1 && ', '}
                    </>
                  ))}
                </p>
              )}
              {entry.data.articuloNuevo?.map(item => {
                const journal = journalBySlug.get(item.article);
                return journal && (
                  <p>
                    <em>articulo nuevo:</em>{' '}
                    <a href={`/cuaderno/${item.article}`}>{journal.data.title}</a>
                    {item.note && ` — ${item.note}`}
                  </p>
                );
              })}
              {entry.data.specimenNuevo?.map(item => {
                const specimen = specimensById.get(item.specimen);
                return specimen && (
                  <p>
                    <em>specimen nuevo:</em>{' '}
                    <a href={`/#${item.specimen}`}>{specimen.data.name}</a>
                    {item.note && ` — ${item.note}`}
                  </p>
                );
              })}
              {entry.data.cultivando?.map(item => {
                const cultivation = cultivationsBySlug.get(item.cultivation);
                return cultivation && (
                  <p>
                    <em>cultivando:</em>{' '}
                    <a href="/#cultivos">{cultivation.data.name}</a>
                    {item.note && ` — ${item.note}`}
                  </p>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </>
  ) : (
    <>
      <div class="ahora-entry latest">
        <p class="date"><time datetime={latestRendered.entry.data.date.toISOString().slice(0, 10)}>{formatDate(latestRendered.entry.data.date)}</time></p>
        <div class="body">
          <latestRendered.Content />
          {latestRendered.entry.data.escuchando && latestRendered.entry.data.escuchando.length > 0 && (
            <p>
              <em>escuchando:</em>{' '}
              {latestRendered.entry.data.escuchando.map((track, i) => (
                <>
                  <a href={track.url}>{track.artist} — {track.title}</a>
                  {i < latestRendered.entry.data.escuchando!.length - 1 && ', '}
                </>
              ))}
              {' '}<a href="/micelio" class="mycelium-link" title="el micelio">◉</a>
            </p>
          )}
          {latestRendered.entry.data.articuloNuevo?.map(item => {
            const journal = journalBySlug.get(item.article);
            return journal && (
              <p>
                <em>articulo nuevo:</em>{' '}
                <a href={`/cuaderno/${item.article}`}>{journal.data.title}</a>
                {item.note && ` — ${item.note}`}
              </p>
            );
          })}
          {latestRendered.entry.data.specimenNuevo?.map(item => {
            const specimen = specimensById.get(item.specimen);
            return specimen && (
              <p>
                <em>specimen nuevo:</em>{' '}
                <a href={`/#${item.specimen}`}>{specimen.data.name}</a>
                {item.note && ` — ${item.note}`}
              </p>
            );
          })}
          {latestRendered.entry.data.cultivando?.map(item => {
            const cultivation = cultivationsBySlug.get(item.cultivation);
            return cultivation && (
              <p>
                <em>cultivando:</em>{' '}
                <a href="/#cultivos">{cultivation.data.name}</a>
                {item.note && ` — ${item.note}`}
              </p>
            );
          })}
        </div>
      </div>
      {olderRendered.length > 0 && (
        <div class="older-entries">
          {olderRendered.map(({ entry, Content }) => (
            <div class="ahora-entry older">
              <time class="date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
              <div class="body">
                <Content />
                {entry.data.escuchando && entry.data.escuchando.length > 0 && (
                  <p>
                    <em>escuchando:</em>{' '}
                    {entry.data.escuchando.map((track, i) => (
                      <>
                        <a href={track.url}>{track.artist} — {track.title}</a>
                        {i < entry.data.escuchando!.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                )}
                {entry.data.articuloNuevo?.map(item => {
                  const journal = journalBySlug.get(item.article);
                  return journal && (
                    <p>
                      <em>articulo nuevo:</em>{' '}
                      <a href={`/cuaderno/${item.article}`}>{journal.data.title}</a>
                      {item.note && ` — ${item.note}`}
                    </p>
                  );
                })}
                {entry.data.specimenNuevo?.map(item => {
                  const specimen = specimensById.get(item.specimen);
                  return specimen && (
                    <p>
                      <em>specimen nuevo:</em>{' '}
                      <a href={`/#${item.specimen}`}>{specimen.data.name}</a>
                      {item.note && ` — ${item.note}`}
                    </p>
                  );
                })}
                {entry.data.cultivando?.map(item => {
                  const cultivation = cultivationsBySlug.get(item.cultivation);
                  return cultivation && (
                    <p>
                      <em>cultivando:</em>{' '}
                      <a href="/#cultivos">{cultivation.data.name}</a>
                      {item.note && ` — ${item.note}`}
                    </p>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      )}
    </>
  )}
</div>

<style>
  .ahora {
    text-align: center;
    padding: var(--rhythm) 0;
  }

  .empty-state,
  .seasonal-message {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0;
  }

  .seasonal-message {
    margin-bottom: var(--rhythm);
  }

  .archive.dimmed {
    opacity: 0.6;
  }

  .ahora-entry {
    margin-bottom: var(--rhythm);
  }

  .ahora-entry:last-child {
    margin-bottom: 0;
  }

  .ahora-entry.latest .date {
    font-family: var(--font-serif);
    font-size: 14px;
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 var(--rhythm-sm) 0;
  }

  .ahora-entry.latest .body {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-line;
  }

  .ahora-entry.older {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    justify-content: center;
    align-items: baseline;
  }

  .ahora-entry.older .date {
    font-family: var(--font-serif);
    font-size: 14px;
    font-style: italic;
    color: var(--ink-faint);
  }

  .ahora-entry.older .body {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--ink-faint);
    line-height: 1.5;
    white-space: pre-line;
  }

  .older-entries {
    margin-top: var(--rhythm-lg);
    padding-top: var(--rhythm);
    border-top: 1px solid var(--ink-faint);
  }

  /* Markdown content styling */
  .body :global(p) {
    margin: 0;
  }

  .body :global(p + p) {
    margin-top: 0.5em;
  }

  .body :global(em) {
    color: var(--ink-soft);
  }

  .body :global(a[href^="http"]) {
    white-space: nowrap;
    padding: 8px 4px;
    margin: -8px -4px;
    display: inline-block;
  }

  .body :global(a[href^="http"])::after {
    content: " ↗";
    font-size: 0.8em;
    opacity: 0.6;
  }

  .body :global(.mycelium-link) {
    color: var(--ink-faint);
    text-decoration: none;
    opacity: 0.6;
    font-size: 0.9em;
    transition: opacity 0.2s, color 0.2s;
  }

  .body :global(.mycelium-link:hover) {
    color: var(--fern);
    opacity: 1;
  }

  .body :global(.mycelium-link)::after {
    content: none;
  }
</style>
