---
import type { CollectionEntry } from 'astro:content';
import { resolveWikilinks } from '../../lib/resolve-wikilinks';

interface Props {
  cultivation: CollectionEntry<'cultivations'>;
}

const { cultivation } = Astro.props;
const { slug, name, status, description, repo, links } = cultivation.data;
const descriptionHtml = resolveWikilinks(description);

const statusSymbols: Record<typeof status, string> = {
  growing: '▲',
  dormant: '◐',
  wild: '○',
  composted: '✕',
};

const symbol = statusSymbols[status];
---

<article class="cultivation" id={slug} data-status={status}>
  <p class="status">{symbol} {status}</p>
  <h3>{name}</h3>
  <p class="description" set:html={descriptionHtml} />
  <div class="links">
    {repo && <a href={repo} class="link">repo →</a>}
    {links?.map((link) => <a href={link.url} class="link">{link.label} →</a>)}
    {!repo && !links?.length && <span class="link">seeds</span>}
  </div>
</article>

<style>
  .cultivation {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--paper-deep);
    border: 1px solid var(--paper-line);
    border-radius: 2px;
  }

  .cultivation[data-status="composted"] {
    opacity: 0.6;
  }

  .status {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: lowercase;
    margin: 0 0 8px 0;
  }

  .cultivation[data-status="growing"] .status {
    color: var(--fern);
  }

  .cultivation[data-status="dormant"] .status {
    color: var(--ochre);
  }

  .cultivation[data-status="wild"] .status {
    color: var(--fern);
  }

  .cultivation[data-status="composted"] .status {
    color: var(--ink-faint);
  }

  h3 {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin: 0 0 8px 0;
  }

  .description {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.5;
  }

  .description :global(a) {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--paper-line);
    text-underline-offset: 2px;
  }

  .description :global(a:hover) {
    color: var(--fern);
    text-decoration-color: var(--fern);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    justify-content: flex-end;
  }

  .link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 16px 8px;
    margin: -16px -8px;
    display: inline-block;
  }

  .link:hover {
    color: var(--ink);
  }
</style>
