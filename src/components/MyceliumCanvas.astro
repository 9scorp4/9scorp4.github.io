---
/**
 * MyceliumCanvas - Force-directed graph visualization
 *
 * Custom canvas + minimal force simulation (~100 lines vanilla JS).
 * No dependencies. Upgradable to d3-force later if needed.
 */
---

<div class="mycelium-container">
  <canvas id="mycelium-canvas" aria-label="Network visualization of connected songs"></canvas>
  <div id="mycelium-detail" class="detail-panel" aria-live="polite"></div>
</div>

<script>
  interface MyceliumNode {
    id: string;
    artist: string;
    title: string;
    url: string;
    // Objective (GetSongBPM)
    bpm?: number;
    key?: string;
    openKey?: string;
    timeSignature?: string;
    danceability?: number;
    // Subjective
    energy?: number;
    // Meta
    firstHeard: string;
    appearances: number;
    // Simulation state
    x: number;
    y: number;
    vx: number;
    vy: number;
  }

  interface MyceliumEdge {
    source: string;
    target: string;
    weight: number;
    reasons: string[];
  }

  interface MyceliumGraph {
    nodes: MyceliumNode[];
    edges: MyceliumEdge[];
    generated: string;
  }

  const canvas = document.getElementById('mycelium-canvas') as HTMLCanvasElement;
  const detailPanel = document.getElementById('mycelium-detail') as HTMLDivElement;
  const ctx = canvas.getContext('2d')!;

  // Colors from tokens.css
  const COLORS = {
    paper: '#efe2c2',
    paperLine: '#c9b886',
    fern: '#2d5a3d',
    sun: '#c93f7a',
    ink: '#3d2f1a',
    inkSoft: '#6b5435',
    inkFaint: '#8a7350',
  };

  let nodes: MyceliumNode[] = [];
  let edges: MyceliumEdge[] = [];
  let selectedNode: MyceliumNode | null = null;
  let hoveredNode: MyceliumNode | null = null;
  let isDragging = false;
  let draggedNode: MyceliumNode | null = null;
  let simulationRunning = true;

  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Force simulation parameters
  const REPULSION = 800;
  const ATTRACTION = 0.02;
  const DAMPING = 0.92;
  const MIN_DISTANCE = 60;

  function resize() {
    const container = canvas.parentElement!;
    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;

    ctx.scale(dpr, dpr);
  }

  function initializePositions() {
    const w = canvas.width / (window.devicePixelRatio || 1);
    const h = canvas.height / (window.devicePixelRatio || 1);
    const cx = w / 2;
    const cy = h / 2;

    nodes.forEach((node, i) => {
      // Arrange in a circle initially
      const angle = (i / nodes.length) * Math.PI * 2;
      const radius = Math.min(w, h) * 0.3;
      node.x = cx + Math.cos(angle) * radius + (Math.random() - 0.5) * 20;
      node.y = cy + Math.sin(angle) * radius + (Math.random() - 0.5) * 20;
      node.vx = 0;
      node.vy = 0;
    });
  }

  function applyForces() {
    if (!simulationRunning) return;

    const w = canvas.width / (window.devicePixelRatio || 1);
    const h = canvas.height / (window.devicePixelRatio || 1);

    // Repulsion between all nodes
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const force = REPULSION / (dist * dist);

        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;

        if (a !== draggedNode) {
          a.vx -= fx;
          a.vy -= fy;
        }
        if (b !== draggedNode) {
          b.vx += fx;
          b.vy += fy;
        }
      }
    }

    // Attraction along edges
    const nodeMap = new Map(nodes.map(n => [n.id, n]));
    for (const edge of edges) {
      const a = nodeMap.get(edge.source);
      const b = nodeMap.get(edge.target);
      if (!a || !b) continue;

      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;

      // Stronger attraction for higher weight edges
      const force = ATTRACTION * edge.weight * dist;

      const fx = (dx / dist) * force;
      const fy = (dy / dist) * force;

      if (a !== draggedNode) {
        a.vx += fx;
        a.vy += fy;
      }
      if (b !== draggedNode) {
        b.vx -= fx;
        b.vy -= fy;
      }
    }

    // Center gravity
    const cx = w / 2;
    const cy = h / 2;
    for (const node of nodes) {
      if (node === draggedNode) continue;
      node.vx += (cx - node.x) * 0.001;
      node.vy += (cy - node.y) * 0.001;
    }

    // Apply velocity and damping
    let totalMotion = 0;
    for (const node of nodes) {
      if (node === draggedNode) continue;

      node.vx *= DAMPING;
      node.vy *= DAMPING;

      node.x += node.vx;
      node.y += node.vy;

      // Bounds
      const margin = 30;
      node.x = Math.max(margin, Math.min(w - margin, node.x));
      node.y = Math.max(margin, Math.min(h - margin, node.y));

      totalMotion += Math.abs(node.vx) + Math.abs(node.vy);
    }

    // Stop simulation when settled
    if (totalMotion < 0.5 && !isDragging) {
      simulationRunning = false;
    }
  }

  function draw() {
    const w = canvas.width / (window.devicePixelRatio || 1);
    const h = canvas.height / (window.devicePixelRatio || 1);

    ctx.clearRect(0, 0, w, h);

    // Build node lookup
    const nodeMap = new Map(nodes.map(n => [n.id, n]));

    // Draw edges
    for (const edge of edges) {
      const a = nodeMap.get(edge.source);
      const b = nodeMap.get(edge.target);
      if (!a || !b) continue;

      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = COLORS.paperLine;
      ctx.lineWidth = Math.min(edge.weight, 2);
      ctx.stroke();
    }

    // Draw nodes
    for (const node of nodes) {
      const isHovered = node === hoveredNode;
      const isSelected = node === selectedNode;
      const radius = 6 + Math.min(node.appearances * 2, 8);

      ctx.beginPath();
      ctx.arc(node.x, node.y, radius, 0, Math.PI * 2);

      if (isSelected) {
        ctx.fillStyle = COLORS.sun;
      } else if (isHovered) {
        ctx.fillStyle = COLORS.sun;
      } else {
        ctx.fillStyle = COLORS.fern;
      }
      ctx.fill();

      // Draw label on hover/select
      if (isHovered || isSelected) {
        ctx.font = '14px "IM Fell DW Pica", Georgia, serif';
        ctx.fillStyle = COLORS.ink;
        ctx.textAlign = 'center';
        ctx.fillText(node.title, node.x, node.y - radius - 8);
        ctx.font = '12px "IM Fell DW Pica", Georgia, serif';
        ctx.fillStyle = COLORS.inkSoft;
        ctx.fillText(node.artist, node.x, node.y - radius - 22);
      }
    }
  }

  function findNodeAt(x: number, y: number): MyceliumNode | null {
    for (const node of nodes) {
      const radius = 6 + Math.min(node.appearances * 2, 8);
      const dx = node.x - x;
      const dy = node.y - y;
      if (dx * dx + dy * dy <= radius * radius) {
        return node;
      }
    }
    return null;
  }

  function showDetail(node: MyceliumNode) {
    const hasBpm = node.bpm !== undefined;
    const hasKey = node.key !== undefined;
    const hasOpenKey = node.openKey !== undefined;
    const hasDanceability = node.danceability !== undefined;
    const hasEnriched = hasBpm || hasKey || hasOpenKey || hasDanceability;

    let html = `
      <p class="detail-title"><a href="${node.url}" target="_blank" rel="noopener">${node.artist} — ${node.title}</a></p>
      <p class="detail-meta">first heard: ${node.firstHeard}</p>
    `;

    if (hasEnriched) {
      const parts: string[] = [];
      if (hasBpm) parts.push(`${node.bpm} bpm`);
      if (hasKey) parts.push(node.openKey ? `${node.key} (${node.openKey})` : node.key!);
      if (hasDanceability) parts.push(`dance: ${node.danceability}`);
      if (node.timeSignature && node.timeSignature !== '4/4') parts.push(node.timeSignature);
      html += `<p class="detail-meta">${parts.join(' · ')}</p>`;
    }

    if (hasEnriched) {
      html += `<p class="detail-attribution">via <a href="https://getsongbpm.com" target="_blank" rel="noopener">getsongbpm.com</a></p>`;
    }

    detailPanel.innerHTML = html;
    detailPanel.classList.add('visible');
  }

  function hideDetail() {
    detailPanel.classList.remove('visible');
  }

  // Event handlers
  function getCanvasCoords(e: MouseEvent | Touch): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    return {
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
    };
  }

  canvas.addEventListener('mousemove', (e) => {
    const { x, y } = getCanvasCoords(e);

    if (isDragging && draggedNode) {
      draggedNode.x = x;
      draggedNode.y = y;
      draggedNode.vx = 0;
      draggedNode.vy = 0;
      return;
    }

    const node = findNodeAt(x, y);
    if (node !== hoveredNode) {
      hoveredNode = node;
      canvas.style.cursor = node ? 'pointer' : 'grab';
    }
  });

  canvas.addEventListener('mousedown', (e) => {
    const { x, y } = getCanvasCoords(e);
    const node = findNodeAt(x, y);

    if (node) {
      isDragging = true;
      draggedNode = node;
      selectedNode = node;
      showDetail(node);
      simulationRunning = true;
      canvas.style.cursor = 'grabbing';
    }
  });

  canvas.addEventListener('mouseup', () => {
    isDragging = false;
    draggedNode = null;
    canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
  });

  canvas.addEventListener('mouseleave', () => {
    hoveredNode = null;
    isDragging = false;
    draggedNode = null;
  });

  canvas.addEventListener('click', (e) => {
    const { x, y } = getCanvasCoords(e);
    const node = findNodeAt(x, y);

    if (node) {
      selectedNode = node;
      showDetail(node);
    } else {
      selectedNode = null;
      hideDetail();
    }
  });

  // Touch support
  canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
    const touch = e.touches[0];
    const { x, y } = getCanvasCoords(touch);
    const node = findNodeAt(x, y);

    if (node) {
      isDragging = true;
      draggedNode = node;
      selectedNode = node;
      showDetail(node);
      simulationRunning = true;
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (isDragging && draggedNode) {
      const touch = e.touches[0];
      const { x, y } = getCanvasCoords(touch);
      draggedNode.x = x;
      draggedNode.y = y;
      draggedNode.vx = 0;
      draggedNode.vy = 0;
    }
  }, { passive: false });

  canvas.addEventListener('touchend', () => {
    isDragging = false;
    draggedNode = null;
  });

  // Animation loop
  function animate() {
    if (!prefersReducedMotion && simulationRunning) {
      applyForces();
    }
    draw();
    requestAnimationFrame(animate);
  }

  // Initialize
  async function init() {
    resize();
    window.addEventListener('resize', () => {
      resize();
      initializePositions();
      simulationRunning = true;
    });

    try {
      const response = await fetch('/mycelium-data.json');
      const data: MyceliumGraph = await response.json();

      nodes = data.nodes.map(n => ({
        ...n,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
      }));
      edges = data.edges;

      if (nodes.length === 0) {
        // Empty state
        detailPanel.innerHTML = '<p class="detail-meta">the network is quiet. songs will appear as dispatches accumulate.</p>';
        detailPanel.classList.add('visible');
      }

      initializePositions();

      if (prefersReducedMotion) {
        // Skip animation, just run simulation to settle
        for (let i = 0; i < 100; i++) {
          applyForces();
        }
        simulationRunning = false;
      }

      animate();
    } catch (error) {
      console.error('[mycelium] Failed to load data:', error);
      detailPanel.innerHTML = '<p class="detail-meta">failed to load the network.</p>';
      detailPanel.classList.add('visible');
    }
  }

  init();
</script>

<style>
  .mycelium-container {
    position: relative;
    width: 100%;
    height: 400px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }

  @media (min-width: 600px) {
    .mycelium-container {
      height: 500px;
    }
  }

  #mycelium-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .detail-panel {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: var(--paper-deep);
    border: 1px solid var(--paper-line);
    padding: 12px 16px;
    font-family: var(--font-serif);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .detail-panel.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .detail-panel :global(.detail-title) {
    margin: 0 0 4px 0;
    font-size: 16px;
    color: var(--ink);
  }

  .detail-panel :global(.detail-title a) {
    color: var(--fern);
    text-decoration: none;
  }

  .detail-panel :global(.detail-title a:hover) {
    text-decoration: underline;
  }

  .detail-panel :global(.detail-meta) {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    font-style: italic;
  }

  .detail-panel :global(.detail-attribution) {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: var(--ink-faint);
  }

  .detail-panel :global(.detail-attribution a) {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .detail-panel :global(.detail-attribution a:hover) {
    color: var(--fern);
    text-decoration: underline;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .detail-panel {
      transition: none;
    }
  }
</style>
