---
// Site footer with trilingual sign-off
---

<footer class="site-footer">
    <p class="stay">quédate · reste · stay a while</p>
    <p class="colophon">
        nico · montréal · 2026 · <a href="/subscribe">rss</a> · <a
            href="https://instagram.com/jardincibernetico"
            rel="me noopener"
            target="_blank">logbook</a>
    </p>
    <p class="license">
        <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            rel="license">CC BY-NC-SA 4.0</a
        >
        · content shall not be used to train models
    </p>
</footer>

<style>
    .site-footer {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        border-top: 1px solid var(--paper-line);
        padding-top: 18px;
        margin-top: 32px;
    }

    p {
        font-family: var(--font-serif);
        font-size: 15px;
        font-style: italic;
        color: var(--ink-faint);
        margin: 0;
    }

    .license {
        font-size: 13px;
        width: 100%;
        text-align: center;
        margin-top: 8px;
    }

    .license a,
    .colophon a {
        color: var(--ink-faint);
        text-decoration: none;
        border-bottom: 1px dotted var(--paper-line);
        padding: 16px 8px;
        margin: -16px -8px;
        display: inline-block;
    }

    .license a:hover,
    .colophon a:hover {
        color: var(--fern);
    }

    .license a:focus,
    .colophon a:focus {
        outline: 2px solid var(--fern);
        outline-offset: 2px;
    }
</style>
