---
type SectionSlug = 'now' | 'conservatory' | 'journal' | 'cultivations' | 'library' | 'visitors';

interface Props {
  slug: SectionSlug;
}

const { slug } = Astro.props;
---

{slug === 'now' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <circle cx="8" cy="8" r="3" fill="var(--sun)" />
    <circle cx="8" cy="8" r="6" fill="none" stroke="var(--ochre)" stroke-width="1" />
  </svg>
)}

{slug === 'conservatory' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <path d="M8 14 L8 6 M8 8 Q4 8 4 4 M8 8 Q12 8 12 4" stroke="var(--fern)" stroke-width="1.5" fill="none" stroke-linecap="round" />
  </svg>
)}

{slug === 'journal' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <path d="M2 14 L8 2 L14 14 Z" fill="none" stroke="var(--terracotta)" stroke-width="1.5" />
  </svg>
)}

{slug === 'cultivations' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <path d="M8 14 L8 4 M8 8 Q3 6 3 2 M8 8 Q13 6 13 2 M8 11 Q5 10 5 7 M8 11 Q11 10 11 7" stroke="var(--fern)" stroke-width="1" fill="none" stroke-linecap="round" />
  </svg>
)}

{slug === 'library' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <path d="M2 13 L2 3 Q8 5 8 3 Q8 5 14 3 L14 13 Q8 11 8 13 Q8 11 2 13 Z" stroke="var(--fern)" stroke-width="1" fill="none" stroke-linejoin="round" />
    <path d="M8 3 L8 13" stroke="var(--fern)" stroke-width="1" />
  </svg>
)}

{slug === 'visitors' && (
  <svg viewBox="0 0 16 16" width="18" height="18" class="section-icon" aria-hidden="true">
    <path d="M4 14 Q5 10 7 8 Q10 5 12 2 M12 2 L10 3 M12 2 L11 4" stroke="var(--fern)" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

<style>
  .section-icon {
    flex-shrink: 0;
  }
</style>
