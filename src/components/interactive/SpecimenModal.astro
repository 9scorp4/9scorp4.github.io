---
/**
 * SpecimenModal - Full-size specimen viewer overlay
 *
 * Rendered hidden by default; client-side script handles opening/closing.
 * The modal loads p5 sketches dynamically when opened.
 *
 * Logic extracted to src/lib/specimen-modal/ for maintainability.
 */
const workerUrl = import.meta.env.PUBLIC_VISITORS_WORKER_URL || '';
---

<div class="modal-backdrop" id="specimen-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-container">
    <button class="modal-close" aria-label="close modal" type="button">&times;</button>

    <div class="modal-header">
      <p class="modal-series" id="modal-series"></p>
      <h3 class="modal-name" id="modal-name"></h3>
    </div>

    <div class="modal-canvas" id="modal-canvas" aria-hidden="true">
      <div class="modal-loading">
        <span class="loading-text">loading...</span>
      </div>
    </div>

    <p class="modal-description" id="modal-description"></p>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(5, 5, 5, 0.92);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--rhythm);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .modal-backdrop[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop[aria-hidden="false"] .modal-container {
    transform: translateY(0);
  }

  .modal-container {
    position: relative;
    max-width: 480px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    gap: var(--rhythm-sm);
    transform: translateY(10px);
    transition: transform 0.2s ease;
  }

  .modal-close {
    position: absolute;
    top: -44px;
    right: -4px;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: var(--paper);
    font-size: 1.778rem;
    font-family: var(--font-serif);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s ease, color 0.15s ease;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-close:hover {
    opacity: 1;
    color: var(--sun);
  }

  .modal-close:focus-visible {
    outline: 2px solid var(--fern);
    outline-offset: 2px;
  }

  .modal-header {
    text-align: center;
    padding: 0 var(--rhythm-sm);
  }

  .modal-series {
    font-family: var(--font-mono);
    font-size: 0.611rem;
    color: var(--sun);
    letter-spacing: 1.5px;
    margin: 0 0 6px 0;
    text-transform: lowercase;
  }

  .modal-series:empty {
    display: none;
  }

  .modal-name {
    font-family: var(--font-serif);
    font-size: 1.222rem;
    font-style: italic;
    font-weight: 400;
    color: var(--paper);
    margin: 0;
  }

  .modal-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 65vh;
    background: rgb(5, 5, 5);
    border: 1px solid rgba(201, 63, 122, 0.3);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), 0 0 40px rgba(201, 63, 122, 0.1);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-canvas[data-aspect="1:1"] {
    aspect-ratio: 1 / 1;
  }

  .modal-canvas[data-aspect="4:5"] {
    aspect-ratio: 4 / 5;
  }

  .modal-canvas :global(canvas) {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .modal-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(5, 5, 5);
    transition: opacity 0.3s ease;
  }

  .modal-loading.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loading-text {
    font-family: var(--font-mono);
    font-size: 0.722rem;
    color: var(--paper-line);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .modal-description {
    font-family: var(--font-serif);
    font-size: 0.833rem;
    font-style: italic;
    color: var(--paper);
    opacity: 0.75;
    text-align: center;
    margin: 0;
    padding: 0 var(--rhythm);
    line-height: 1.5;
  }

  /* Reduced motion: no backdrop blur, instant transitions */
  @media (prefers-reduced-motion: reduce) {
    .modal-backdrop {
      backdrop-filter: none;
      transition: none;
    }

    .modal-loading {
      transition: none;
    }

    .loading-text {
      animation: none;
      opacity: 0.75;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 600px) {
    .modal-container {
      max-width: 100%;
    }

    .modal-canvas {
      max-height: 60vh;
    }

    .modal-close {
      top: -36px;
    }
  }
</style>

<script define:vars={{ workerUrl }}>
  // Inject worker URL for analytics (must be inline for SSR variable access)
  window.__specimenWorkerUrl = workerUrl;
</script>
<script>
  import { initSpecimenModal } from '../../lib/specimen-modal';
  initSpecimenModal();
</script>
