---
/**
 * MyceliumCanvas - Force-directed graph visualization
 *
 * Uses d3-force for physics simulation, canvas for rendering.
 */
---

<div class="mycelium-container">
  <canvas id="mycelium-canvas" aria-label="Network visualization of connected songs"></canvas>
  <div id="mycelium-detail" class="detail-panel" aria-live="polite"></div>
</div>
<div id="mycelium-attribution" class="mycelium-footer-attribution"></div>

<script>
  import {
    forceSimulation,
    forceLink,
    forceManyBody,
    forceCenter,
    forceCollide,
    type Simulation,
    type SimulationNodeDatum,
    type SimulationLinkDatum,
  } from 'd3-force';

  interface MyceliumNodeData {
    id: string;
    artist: string;
    title: string;
    url: string;
    bpm?: number;
    key?: string;
    openKey?: string;
    timeSignature?: string;
    danceability?: number;
    songbpmId?: string;
    sourceVerified?: boolean;
    corrections?: string;
    energy?: number;
    firstHeard: string;
    appearances: number;
  }

  interface MyceliumEdgeData {
    source: string;
    target: string;
    weight: number;
    reasons: string[];
  }

  interface MyceliumGraph {
    nodes: MyceliumNodeData[];
    edges: MyceliumEdgeData[];
    generated: string;
    meta?: {
      tracksFromSongbpm: number;
    };
  }

  // Simulation node with d3 position data
  interface SimNode extends SimulationNodeDatum, MyceliumNodeData {
    x: number;
    y: number;
    fx?: number | null;
    fy?: number | null;
  }

  // Simulation link with resolved node references
  interface SimLink extends SimulationLinkDatum<SimNode> {
    source: SimNode;
    target: SimNode;
    weight: number;
    reasons: string[];
  }

  const canvas = document.getElementById('mycelium-canvas') as HTMLCanvasElement;
  const detailPanel = document.getElementById('mycelium-detail') as HTMLDivElement;
  const ctx = canvas.getContext('2d')!;

  // Colors from tokens.css
  const COLORS = {
    paper: '#efe2c2',
    paperLine: '#c9b886',
    fern: '#2d5a3d',
    sun: '#c93f7a',
    ink: '#3d2f1a',
    inkSoft: '#6b5435',
    inkFaint: '#8a7350',
  };

  let nodes: SimNode[] = [];
  let links: SimLink[] = [];
  let simulation: Simulation<SimNode, SimLink> | null = null;
  let selectedNode: SimNode | null = null;
  let hoveredNode: SimNode | null = null;
  let draggedNode: SimNode | null = null;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function resize() {
    const container = canvas.parentElement!;
    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;

    ctx.scale(dpr, dpr);

    // Update force center
    if (simulation) {
      const w = rect.width;
      const h = rect.height;
      simulation.force('center', forceCenter(w / 2, h / 2));
      simulation.alpha(0.3).restart();
    }
  }

  function getNodeRadius(node: SimNode): number {
    return 6 + Math.min(node.appearances * 2, 8);
  }

  function draw() {
    const w = canvas.width / (window.devicePixelRatio || 1);
    const h = canvas.height / (window.devicePixelRatio || 1);

    ctx.clearRect(0, 0, w, h);

    // Draw edges
    ctx.strokeStyle = COLORS.paperLine;
    for (const link of links) {
      if (link.source.x == null || link.target.x == null) continue;

      ctx.beginPath();
      ctx.moveTo(link.source.x, link.source.y);
      ctx.lineTo(link.target.x, link.target.y);
      ctx.lineWidth = Math.min(link.weight, 2);
      ctx.stroke();
    }

    // Draw nodes
    for (const node of nodes) {
      if (node.x == null) continue;

      const isHovered = node === hoveredNode;
      const isSelected = node === selectedNode;
      const radius = getNodeRadius(node);

      ctx.beginPath();
      ctx.arc(node.x, node.y, radius, 0, Math.PI * 2);
      ctx.fillStyle = (isSelected || isHovered) ? COLORS.sun : COLORS.fern;
      ctx.fill();

      // Draw label on hover/select
      if (isHovered || isSelected) {
        ctx.font = '14px "IM Fell DW Pica", Georgia, serif';
        ctx.fillStyle = COLORS.ink;
        ctx.textAlign = 'center';
        ctx.fillText(node.title, node.x, node.y - radius - 8);
        ctx.font = '12px "IM Fell DW Pica", Georgia, serif';
        ctx.fillStyle = COLORS.inkSoft;
        ctx.fillText(node.artist, node.x, node.y - radius - 22);
      }
    }
  }

  function findNodeAt(x: number, y: number): SimNode | null {
    // Search in reverse order (top nodes first)
    for (let i = nodes.length - 1; i >= 0; i--) {
      const node = nodes[i];
      if (node.x == null) continue;
      const radius = getNodeRadius(node);
      const dx = node.x - x;
      const dy = node.y - y;
      if (dx * dx + dy * dy <= radius * radius) {
        return node;
      }
    }
    return null;
  }

  function showDetail(node: SimNode) {
    const hasBpm = node.bpm !== undefined;
    const hasKey = node.key !== undefined;
    const hasOpenKey = node.openKey !== undefined;
    const hasDanceability = node.danceability !== undefined;
    const hasEnriched = hasBpm || hasKey || hasOpenKey || hasDanceability;

    let html = `
      <p class="detail-title"><a href="${node.url}" target="_blank" rel="noopener">${node.artist} — ${node.title}</a></p>
      <p class="detail-meta">first heard: ${node.firstHeard}</p>
    `;

    if (hasEnriched) {
      const parts: string[] = [];
      if (hasBpm) parts.push(`${node.bpm} bpm`);
      if (hasKey) parts.push(node.openKey ? `${node.key} (${node.openKey})` : node.key!);
      if (hasDanceability) parts.push(`dance: ${node.danceability}`);
      if (node.timeSignature && node.timeSignature !== '4/4') parts.push(node.timeSignature);
      html += `<p class="detail-meta">${parts.join(' · ')}</p>`;
    }

    if (node.songbpmId) {
      html += `<p class="detail-attribution">via <a href="https://getsongbpm.com/song/${node.songbpmId}" target="_blank" rel="noopener">getsongbpm.com</a>`;
      if (node.sourceVerified) html += ` · verified`;
      html += `</p>`;
      if (node.corrections) {
        html += `<p class="detail-attribution">corrections: ${node.corrections}</p>`;
      }
    } else if (hasEnriched) {
      // manually sourced (Beatport, tap-tempo, etc.)
      html += `<p class="detail-attribution">metadata harvested manually</p>`;
    }

    detailPanel.innerHTML = html;
    detailPanel.classList.add('visible');
  }

  function hideDetail() {
    detailPanel.classList.remove('visible');
  }

  // Event handlers
  function getCanvasCoords(e: MouseEvent | Touch): { x: number; y: number } {
    const rect = canvas.getBoundingClientRect();
    return {
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
    };
  }

  canvas.addEventListener('mousemove', (e) => {
    const { x, y } = getCanvasCoords(e);

    if (draggedNode) {
      draggedNode.fx = x;
      draggedNode.fy = y;
      simulation?.alpha(0.3).restart();
      return;
    }

    const node = findNodeAt(x, y);
    if (node !== hoveredNode) {
      hoveredNode = node;
      canvas.style.cursor = node ? 'pointer' : 'grab';
      draw();
    }
  });

  canvas.addEventListener('mousedown', (e) => {
    const { x, y } = getCanvasCoords(e);
    const node = findNodeAt(x, y);

    if (node) {
      draggedNode = node;
      selectedNode = node;
      node.fx = x;
      node.fy = y;
      showDetail(node);
      simulation?.alphaTarget(0.3).restart();
      canvas.style.cursor = 'grabbing';
    }
  });

  canvas.addEventListener('mouseup', () => {
    if (draggedNode) {
      draggedNode.fx = null;
      draggedNode.fy = null;
      draggedNode = null;
      simulation?.alphaTarget(0);
    }
    canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
  });

  canvas.addEventListener('mouseleave', () => {
    if (draggedNode) {
      draggedNode.fx = null;
      draggedNode.fy = null;
      draggedNode = null;
      simulation?.alphaTarget(0);
    }
    hoveredNode = null;
    draw();
  });

  canvas.addEventListener('click', (e) => {
    const { x, y } = getCanvasCoords(e);
    const node = findNodeAt(x, y);

    if (node) {
      selectedNode = node;
      showDetail(node);
    } else {
      selectedNode = null;
      hideDetail();
    }
    draw();
  });

  // Touch support
  canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
    const touch = e.touches[0];
    const { x, y } = getCanvasCoords(touch);
    const node = findNodeAt(x, y);

    if (node) {
      draggedNode = node;
      selectedNode = node;
      node.fx = x;
      node.fy = y;
      showDetail(node);
      simulation?.alphaTarget(0.3).restart();
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', (e) => {
    e.preventDefault();
    if (draggedNode) {
      const touch = e.touches[0];
      const { x, y } = getCanvasCoords(touch);
      draggedNode.fx = x;
      draggedNode.fy = y;
    }
  }, { passive: false });

  canvas.addEventListener('touchend', () => {
    if (draggedNode) {
      draggedNode.fx = null;
      draggedNode.fy = null;
      draggedNode = null;
      simulation?.alphaTarget(0);
    }
  });

  // Initialize
  async function init() {
    resize();
    window.addEventListener('resize', resize);

    try {
      const response = await fetch('/mycelium-data.json');
      const data: MyceliumGraph = await response.json();

      if (data.nodes.length === 0) {
        detailPanel.innerHTML = '<p class="detail-meta">the network is quiet. songs will appear as dispatches accumulate.</p>';
        detailPanel.classList.add('visible');
        return;
      }

      // Show footer attribution if any tracks came from songbpm
      const songbpmCount = data.nodes.filter(n => n.songbpmId).length;
      const attrEl = document.getElementById('mycelium-attribution');
      if (songbpmCount > 0 && attrEl) {
        attrEl.innerHTML = `some tempo data via <a href="https://getsongbpm.com" target="_blank" rel="noopener">GetSongBPM</a>`;
        attrEl.classList.add('visible');
      }

      const w = canvas.width / (window.devicePixelRatio || 1);
      const h = canvas.height / (window.devicePixelRatio || 1);

      // Create simulation nodes
      nodes = data.nodes.map(n => ({
        ...n,
        x: w / 2 + (Math.random() - 0.5) * 100,
        y: h / 2 + (Math.random() - 0.5) * 100,
      }));

      // Create node lookup for link resolution
      const nodeById = new Map(nodes.map(n => [n.id, n]));

      // Create simulation links
      links = data.edges
        .map(e => ({
          source: nodeById.get(e.source)!,
          target: nodeById.get(e.target)!,
          weight: e.weight,
          reasons: e.reasons,
        }))
        .filter(l => l.source && l.target);

      // Create simulation
      simulation = forceSimulation<SimNode>(nodes)
        .force('link', forceLink<SimNode, SimLink>(links)
          .id(d => d.id)
          .distance(80)
          .strength(l => l.weight * 0.3))
        .force('charge', forceManyBody<SimNode>()
          .strength(-200))
        .force('center', forceCenter(w / 2, h / 2))
        .force('collide', forceCollide<SimNode>()
          .radius(d => getNodeRadius(d) + 4))
        .on('tick', draw);

      // For reduced motion, run simulation silently then stop
      if (prefersReducedMotion) {
        simulation.stop();
        for (let i = 0; i < 300; i++) {
          simulation.tick();
        }
        draw();
      }
    } catch (error) {
      console.error('[mycelium] Failed to load data:', error);
      detailPanel.innerHTML = '<p class="detail-meta">failed to load the network.</p>';
      detailPanel.classList.add('visible');
    }
  }

  init();
</script>

<style>
  .mycelium-container {
    position: relative;
    width: 100%;
    height: 400px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }

  @media (min-width: 600px) {
    .mycelium-container {
      height: 500px;
    }
  }

  #mycelium-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .detail-panel {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: var(--paper-deep);
    border: 1px solid var(--paper-line);
    padding: 12px 16px;
    font-family: var(--font-serif);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .detail-panel.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .detail-panel :global(.detail-title) {
    margin: 0 0 4px 0;
    font-size: 16px;
    color: var(--ink);
  }

  .detail-panel :global(.detail-title a) {
    color: var(--fern);
    text-decoration: none;
  }

  .detail-panel :global(.detail-title a:hover) {
    text-decoration: underline;
  }

  .detail-panel :global(.detail-meta) {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    font-style: italic;
  }

  .detail-panel :global(.detail-attribution) {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: var(--ink-faint);
  }

  .detail-panel :global(.detail-attribution a) {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .detail-panel :global(.detail-attribution a:hover) {
    color: var(--fern);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-panel {
      transition: none;
    }
  }

  .mycelium-footer-attribution {
    text-align: center;
    margin-top: var(--rhythm);
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--ink-faint);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .mycelium-footer-attribution.visible {
    opacity: 1;
  }

  .mycelium-footer-attribution a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .mycelium-footer-attribution a:hover {
    color: var(--fern);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .mycelium-footer-attribution {
      transition: none;
    }
  }
</style>
