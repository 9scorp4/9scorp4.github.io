---
/**
 * MyceliumCanvas - Force-directed graph visualization
 *
 * Uses d3-force for physics simulation, canvas for rendering.
 */
const workerUrl = import.meta.env.PUBLIC_VISITORS_WORKER_URL || '';
---

<div class="mycelium-container">
  <canvas id="mycelium-canvas" data-worker-url={workerUrl} aria-label="Network visualization of connected songs and writings"></canvas>
  <div id="mycelium-detail" class="detail-panel" aria-live="polite"></div>
  <details class="legend">
    <summary class="legend-toggle">legend</summary>
    <div class="legend-content">
      <div class="legend-item">
        <span class="legend-shape circle track"></span>
        <span class="legend-label">track</span>
      </div>
      <div class="legend-item">
        <span class="legend-shape square article"></span>
        <span class="legend-label">article</span>
      </div>
      <div class="legend-item">
        <span class="legend-shape square cultivation"></span>
        <span class="legend-label">cultivation</span>
      </div>
      <div class="legend-item">
        <span class="legend-shape square dispatch"></span>
        <span class="legend-label">dispatch</span>
      </div>
      <div class="legend-item">
        <span class="legend-shape circle-hollow exit"></span>
        <span class="legend-label">exit</span>
      </div>
      <div class="legend-item">
        <span class="legend-shape square diamond external-article"></span>
        <span class="legend-label">cited article</span>
      </div>
      <div class="legend-divider"></div>
      <div class="legend-item">
        <span class="legend-line musical"></span>
        <span class="legend-label">musical</span>
      </div>
      <div class="legend-item">
        <span class="legend-line cite-section"></span>
        <span class="legend-label">cites &sect;</span>
      </div>
      <div class="legend-item">
        <span class="legend-line cite-text"></span>
        <span class="legend-label">cites text</span>
      </div>
      <div class="legend-item">
        <span class="legend-line cite-block"></span>
        <span class="legend-label">cites ^block</span>
      </div>
      <div class="legend-item">
        <span class="legend-line cite-heading"></span>
        <span class="legend-label">cites #heading</span>
      </div>
      <div class="legend-item">
        <span class="legend-line exit-edge"></span>
        <span class="legend-label">exit link</span>
      </div>
      <div class="legend-item">
        <span class="legend-line citation-edge"></span>
        <span class="legend-label">cites external</span>
      </div>
    </div>
  </details>
</div>
<div id="mycelium-attribution" class="mycelium-footer-attribution"></div>

<script>
  import type { Simulation } from 'd3-force';
  import {
    type SimNode,
    type SimLink,
    type Transform,
    draw,
    loadGraph,
    updateSimulationForResize,
    attachMouseHandlers,
    attachTouchHandlers,
  } from '../../lib/mycelium-canvas';

  const canvas = document.getElementById('mycelium-canvas') as HTMLCanvasElement;
  const workerUrl = canvas.dataset.workerUrl || '';
  const detailPanel = document.getElementById('mycelium-detail') as HTMLDivElement;
  const ctx = canvas.getContext('2d')!;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // State
  let nodes: SimNode[] = [];
  let links: SimLink[] = [];
  let simulation: Simulation<SimNode, SimLink> | null = null;
  let transform: Transform = { x: 0, y: 0, scale: 1 };
  let selectedNode: SimNode | null = null;
  let hoveredNode: SimNode | null = null;
  let draggedNode: SimNode | null = null;

  function getCanvasSize() {
    return {
      width: canvas.width / (window.devicePixelRatio || 1),
      height: canvas.height / (window.devicePixelRatio || 1),
    };
  }

  function render() {
    const { width, height } = getCanvasSize();
    draw({ ctx, nodes, links, transform, hoveredNode, selectedNode, canvasWidth: width, canvasHeight: height });
  }

  function resize() {
    const container = canvas.parentElement!;
    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;
    ctx.scale(dpr, dpr);
    if (simulation) updateSimulationForResize(simulation, rect.width, rect.height);
  }

  // Context for event handlers
  const handlerCtx = {
    canvas,
    detailPanel,
    getNodes: () => nodes,
    getLinks: () => links,
    getTransform: () => transform,
    setTransform: (t: Transform) => { transform = t; },
    getSimulation: () => simulation,
    getSelectedNode: () => selectedNode,
    setSelectedNode: (n: SimNode | null) => { selectedNode = n; },
    getHoveredNode: () => hoveredNode,
    setHoveredNode: (n: SimNode | null) => { hoveredNode = n; },
    getDraggedNode: () => draggedNode,
    setDraggedNode: (n: SimNode | null) => { draggedNode = n; },
    render,
    workerUrl,
  };

  // Attach event handlers
  attachMouseHandlers(handlerCtx);
  attachTouchHandlers(handlerCtx);

  // Initialize
  async function init() {
    resize();
    window.addEventListener('resize', resize);

    try {
      const { width, height } = getCanvasSize();
      const result = await loadGraph({
        canvasWidth: width,
        canvasHeight: height,
        prefersReducedMotion,
        onTick: render,
      });

      if (!result) {
        detailPanel.innerHTML = '<p class="detail-meta">the network is quiet. songs will appear as dispatches accumulate.</p>';
        detailPanel.classList.add('visible');
        return;
      }

      nodes = result.nodes;
      links = result.links;
      simulation = result.simulation;

      // Show footer attribution if any tracks came from songbpm
      const songbpmCount = nodes.filter(n => n.songbpmId).length;
      const attrEl = document.getElementById('mycelium-attribution');
      if (songbpmCount > 0 && attrEl) {
        attrEl.innerHTML = `some tempo data via <a href="https://getsongbpm.com" target="_blank" rel="noopener">GetSongBPM</a>`;
        attrEl.classList.add('visible');
      }
    } catch (error) {
      console.error('[mycelium] Failed to load data:', error);
      detailPanel.innerHTML = '<p class="detail-meta">failed to load the network.</p>';
      detailPanel.classList.add('visible');
    }
  }

  init();
</script>

<style>
  .mycelium-container {
    position: relative;
    width: 100%;
    height: 400px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }

  @media (min-width: 600px) {
    .mycelium-container {
      height: 500px;
    }
  }

  #mycelium-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .detail-panel {
    position: absolute;
    bottom: 12px;
    left: 12px;
    max-width: 320px;
    background: var(--paper-deep);
    border: 1px solid var(--paper-line);
    padding: 12px 16px;
    font-family: var(--font-serif);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
  }

  .detail-panel.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .detail-panel :global(.detail-title) {
    margin: 0 0 4px 0;
    font-size: 16px;
    color: var(--ink);
  }

  .detail-panel :global(.detail-title a) {
    color: var(--fern);
    text-decoration: none;
  }

  .detail-panel :global(.detail-title a:hover) {
    text-decoration: underline;
  }

  .detail-panel :global(.detail-meta) {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    font-style: italic;
  }

  .detail-panel :global(.detail-attribution) {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: var(--ink-faint);
  }

  .detail-panel :global(.detail-attribution a) {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .detail-panel :global(.detail-attribution a:hover) {
    color: var(--fern);
    text-decoration: underline;
  }

  .detail-panel :global(.detail-action) {
    margin: 8px 0 0 0;
    font-size: 14px;
  }

  .detail-panel :global(.detail-action a) {
    color: var(--fern);
    text-decoration: none;
    font-style: italic;
  }

  .detail-panel :global(.detail-action a:hover) {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .detail-panel {
      transition: none;
    }
  }

  .mycelium-footer-attribution {
    text-align: center;
    margin-top: var(--rhythm);
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--ink-faint);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .mycelium-footer-attribution.visible {
    opacity: 1;
  }

  .mycelium-footer-attribution a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .mycelium-footer-attribution a:hover {
    color: var(--fern);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .mycelium-footer-attribution {
      transition: none;
    }
  }
</style>

<!-- Legend styles imported globally -->
<style is:global>
  @import '../../styles/mycelium-legend.css';
</style>
