---
/**
 * VisitorsBook - Interactive CLI console for the garden
 *
 * Parser-flavored, terse responses. Occasionally quotes Bateson.
 * Tracks visitor state in localStorage.
 */

import { getCollection } from 'astro:content';

// Fetch content at build time
const specimens = await getCollection('specimens');
const journalEntries = await getCollection('journal', ({ data }) => !data.draft);
const cultivations = await getCollection('cultivations');
const visitorMessages = await getCollection('visitors');

// Worker URL for submissions (injected at build time, set in astro.config or env)
const VISITORS_WORKER_URL = import.meta.env.PUBLIC_VISITORS_WORKER_URL || '';

// Serialize content for client-side use
const contentData = {
  specimens: specimens.map(s => ({
    id: s.data.id,
    name: s.data.name,
    grown: s.data.grown.toISOString(),
    series: s.data.series,
  })),
  journal: journalEntries.map(e => ({
    slug: e.slug,
    title: e.data.title,
    date: e.data.date.toISOString(),
    summary: e.data.summary,
    language: e.data.language,
    type: e.data.type,
  })),
  cultivations: cultivations.map(c => ({
    slug: c.data.slug,
    name: c.data.name,
    status: c.data.status,
  })),
  visitors: visitorMessages
    .map(v => ({
      id: v.data.id,
      nombre: v.data.nombre,
      mensaje: v.data.mensaje,
      timestamp: v.data.timestamp,
    }))
    .sort((a, b) => b.timestamp.localeCompare(a.timestamp)), // newest first
  workerUrl: VISITORS_WORKER_URL,
};

const batesonQuotes = [
  "The map is not the territory.",
  "Information is a difference that makes a difference.",
  "The pattern which connects.",
  "We are not outside the ecology for which we plan.",
  "The major problems in the world are the result of the difference between how nature works and the way people think.",
  "Logic is a poor model of cause and effect.",
  "Number is different from quantity.",
  "The creature that wins against its environment destroys itself.",
  "Rigor alone is paralytic death, but imagination alone is insanity.",
  "It takes two to know one.",
  "All experience is subjective.",
  "Language commonly stresses only one side of any interaction.",
  "There is an ecology of bad ideas, just as there is an ecology of weeds.",
];
---

<div class="visitors-book" id="visitors-book" role="region" aria-label="visitors' book console">
  {visitorMessages.length > 0 && (
    <div class="visitor-messages" aria-label="visitor messages">
      {visitorMessages
        .sort((a, b) => b.data.timestamp.localeCompare(a.data.timestamp))
        .slice(0, 10)
        .map((v) => {
          const date = new Date(v.data.timestamp);
          const formatted = date.toLocaleDateString('es', { day: 'numeric', month: 'short', year: '2-digit' });
          return (
            <div class="visitor-message">
              <span class="visitor-meta">
                <span class="visitor-nombre">{v.data.nombre}</span>
                <time class="visitor-date" datetime={v.data.timestamp}>{formatted}</time>
              </span>
              <span class="visitor-texto">"{v.data.mensaje}"</span>
            </div>
          );
        })}
    </div>
  )}
  <div class="console-input-row">
    <label for="console-input" class="prompt">leave a sign</label>
    <span class="prompt-arrow">→</span>
    <div class="input-wrapper">
      <span class="ghost-text" id="ghost-text" aria-hidden="true"></span>
      <input
        type="text"
        id="console-input"
        class="console-input"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-describedby="console-help"
      />
      <span class="text-measurer" id="text-measurer" aria-hidden="true"></span>
      <span class="cursor" id="cursor" aria-hidden="true">_</span>
    </div>
  </div>
  <p class="help" id="console-help">try: random · about · seasons · dejar · ...</p>
  <div class="console-output" id="console-output" role="log" aria-live="polite"></div>
  <div class="jardin-modal-backdrop" id="jardin-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="jardin-modal">
      <p class="jardin-modal-title">you found the ledger.</p>
      <p class="jardin-modal-body">the meta-secret: the secret that holds all the secrets.</p>
      <button class="jardin-modal-dismiss" type="button">continue</button>
    </div>
  </div>
</div>

<script id="garden-content-data" type="application/json" set:html={JSON.stringify(contentData)}></script>
<script id="bateson-quotes" type="application/json" set:html={JSON.stringify(batesonQuotes)}></script>

<style>
  .visitors-book {
    background: var(--paper);
    border: 1px solid var(--paper-line);
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Visitor messages */
  .visitor-messages {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--paper-line);
  }

  .visitor-message {
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .visitor-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 2px;
  }

  .visitor-nombre {
    color: var(--fern);
    font-style: italic;
  }

  .visitor-date {
    font-size: 12px;
    color: var(--ink-faint);
  }

  .visitor-texto {
    font-style: italic;
    color: var(--ink-soft);
    display: block;
    padding-left: 12px;
    border-left: 2px solid var(--paper-line);
  }

  .console-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: text;
  }

  .input-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .prompt {
    font-family: var(--font-serif);
    font-size: 16px;
    font-style: italic;
    color: var(--fern);
    flex-shrink: 0;
  }

  .prompt-arrow {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .console-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 16px; /* ≥16px prevents iOS zoom */
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    caret-color: transparent; /* hide native caret, use custom cursor */
  }

  /* Hidden span to measure text width */
  .text-measurer {
    position: absolute;
    visibility: hidden;
    white-space: pre;
    font-family: var(--font-mono);
    font-size: 16px;
    pointer-events: none;
  }

  .console-input::placeholder {
    color: var(--ink-faint);
    opacity: 0.6;
  }

  .cursor {
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--fern);
    animation: blink 1s step-end infinite;
    pointer-events: none;
  }

  .console-input:focus ~ .cursor {
    color: var(--sun);
  }

  /* Ghost text typing guide */
  .ghost-text {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--ink-faint);
    pointer-events: none;
    white-space: pre;
    opacity: 0.6;
  }

  .ghost-text.hidden {
    display: none;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .help {
    font-family: var(--font-serif);
    font-size: 14px;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0;
  }

  .console-output {
    display: none;
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--ink);
    line-height: 1.6;
    padding-top: 8px;
    border-top: 1px solid var(--paper-line);
  }

  .console-output.expanded {
    display: block;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>

<!-- Output styles imported globally -->
<style is:global>
  @import '../../styles/visitors-book-output.css';
</style>

<script>
  import type { ContentData, VisitorState, CommandContext } from '../../lib/visitors-book';
  import {
    getVisitorState,
    saveVisitorState,
    trackSecretDiscovery,
    createOutputManager,
    createTypingAnimation,
    buildCommandRegistry,
    createCursorManager,
    createCommandExecutor,
    bindRatingHandler,
    initDejarHash,
  } from '../../lib/visitors-book';

  // Parse embedded JSON data
  const contentDataEl = document.getElementById('garden-content-data');
  const batesonQuotesEl = document.getElementById('bateson-quotes');

  const contentData: ContentData = contentDataEl
    ? JSON.parse(contentDataEl.textContent || '{}')
    : { specimens: [], journal: [], cultivations: [], visitors: [], workerUrl: '' };

  const batesonQuotes: string[] = batesonQuotesEl
    ? JSON.parse(batesonQuotesEl.textContent || '[]')
    : [];

  // DOM elements
  const visitorsBook = document.getElementById('visitors-book');
  const input = document.getElementById('console-input') as HTMLInputElement;
  const output = document.getElementById('console-output') as HTMLDivElement;
  const cursor = document.getElementById('cursor') as HTMLSpanElement;
  const textMeasurer = document.getElementById('text-measurer') as HTMLSpanElement;
  const ghostText = document.getElementById('ghost-text') as HTMLSpanElement;
  const jardinModal = document.getElementById('jardin-modal') as HTMLDivElement;
  const jardinDismissBtn = jardinModal?.querySelector('.jardin-modal-dismiss') as HTMLButtonElement;

  // Preferences
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cursor position management
  const { updateCursorPosition } = createCursorManager({ input, cursor, textMeasurer });

  // Typing animation
  const typingAnimation = createTypingAnimation(ghostText, prefersReducedMotion);
  const updateGhostVisibility = () => typingAnimation.updateVisibility(!!input?.value);

  // Output manager
  const outputManager = createOutputManager(
    { output, input, jardinModal, jardinDismissBtn },
    { updateCursorPosition, updateGhostVisibility, startTypingAnimation: () => typingAnimation.start(), prefersReducedMotion }
  );

  // State management
  let visitorState = getVisitorState();
  visitorState.visits++;
  visitorState.lastVisit = new Date().toISOString();
  saveVisitorState(visitorState);

  // Command executor with confirmation mode
  const executor = createCommandExecutor({
    commands: {},
    workerUrl: contentData.workerUrl,
    getVisitorState: () => visitorState,
    saveVisitorState: (state: VisitorState) => { visitorState = state; saveVisitorState(state); },
    showOutput: outputManager.showOutput,
    dismissOutput: outputManager.dismissOutput,
  });

  // Build command context
  const commandContext: CommandContext = {
    contentData,
    workerUrl: contentData.workerUrl,
    getVisitorState: () => visitorState,
    saveVisitorState: (state: VisitorState) => { visitorState = state; saveVisitorState(state); },
    showOutput: outputManager.showOutput,
    dismissOutput: outputManager.dismissOutput,
    showJardinModal: outputManager.showJardinModal,
    trackSecretDiscovery: (name: string) => trackSecretDiscovery(name, visitorState, saveVisitorState),
    batesonQuotes,
    setAwaitingConfirmation: executor.setAwaitingConfirmation,
    getAwaitingConfirmation: executor.getAwaitingConfirmation,
  };

  // Build command registry and update executor
  const commands = buildCommandRegistry(commandContext);
  const finalExecutor = createCommandExecutor({
    commands,
    workerUrl: contentData.workerUrl,
    getVisitorState: () => visitorState,
    saveVisitorState: (state: VisitorState) => { visitorState = state; saveVisitorState(state); },
    showOutput: outputManager.showOutput,
    dismissOutput: outputManager.dismissOutput,
  });

  // Input event handlers
  input?.addEventListener('input', () => {
    updateCursorPosition();
    updateGhostVisibility();
    if (input.value) typingAnimation.stop();
    else if (!prefersReducedMotion) typingAnimation.start();
  });
  input?.addEventListener('keyup', updateCursorPosition);
  input?.addEventListener('click', updateCursorPosition);
  input?.addEventListener('focus', updateCursorPosition);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); finalExecutor.execute(input.value); }
    else if (e.key === 'Escape') outputManager.dismissOutput();
  });

  // Click to focus
  visitorsBook?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'BUTTON' || target.tagName === 'A' || target.closest('.season-header')) return;
    input?.focus();
  });

  // Season header keyboard accessibility
  output?.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('season-header') && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault(); target.click();
    }
  });

  // Modal escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && jardinModal?.getAttribute('aria-hidden') === 'false') outputManager.dismissJardinModal();
  });

  // Rating handler
  bindRatingHandler(output);

  // Hash handler for #dejar
  initDejarHash({ input, updateCursorPosition, updateGhostVisibility, stopTypingAnimation: () => typingAnimation.stop() });

  // Initialize
  updateCursorPosition();
  updateGhostVisibility();
  typingAnimation.start();
</script>
