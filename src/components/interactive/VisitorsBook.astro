  // Escape HTML for safe display
  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Track command usage via beacon (respects DNT)
  function trackCommand(name: string): void {
    if (!contentData.workerUrl || navigator.doNotTrack === '1') return;
    const isSecret = name in secretCommands;
    try {
      navigator.sendBeacon?.(
        contentData.workerUrl + '/track',
        JSON.stringify({
          type: 'command',
          command: name,
          isSecret,
        })
      );
    } catch {
      // Silently fail
    }
  }

  // Track secret discovery (locally, using canonical name)
  function trackSecretDiscovery(name: string): void {
    const canonical = secretCommands[name];
    if (!canonical) return;
    if (visitorState.stats.secretsFound.includes(canonical)) return;
    visitorState.stats.secretsFound.push(canonical);
    saveVisitorState(visitorState);
  }

  // Detect prose vs. command-like input
  function looksLikeProse(input: string): boolean {
    const trimmed = input.trim();
    if (!trimmed) return false;

    const lower = trimmed.toLowerCase();
    const tokens = trimmed.split(/\s+/);

    // Contains ? anywhere
    if (trimmed.includes('?')) return true;

    // Contains . or ! in non-final position
    const midPunctuation = /[.!](?!$)/;
    if (midPunctuation.test(trimmed)) return true;

    // Contains comma (casual speech: "cool page, bro")
    if (trimmed.includes(',')) return true;

    // More than 4 whitespace-separated tokens (lowered threshold)
    if (tokens.length > 4) return true;

    // First token is a greeting (excludes hola/hello/bonjour which are commands)
    const greetings = ['hi', 'hey', 'salut', 'yo', 'ey'];
    const firstToken = tokens[0].toLowerCase().replace(/[!,]$/, '');
    if (greetings.includes(firstToken)) return true;

    // Contains evaluative/complimentary words (not commands)
    const evaluative = ['cool', 'nice', 'great', 'awesome', 'good', 'bad', 'love', 'like', 'beautiful', 'amazing', 'genial', 'bueno', 'bonito', 'increíble', 'thanks', 'gracias', 'merci', 'cheers'];
    if (evaluative.some(word => lower.includes(word))) return true;

    // Contains informal address
    const addresses = ['bro', 'dude', 'man', 'mate', 'amigo', 'tío', 'compa'];
    if (addresses.some(addr => lower.includes(addr))) return true;

    // Multiple tokens without = suggests prose, not command args
    if (tokens.length >= 3 && !trimmed.includes('=')) return true;

    return false;
  }

  // Handle command execution
  function executeCommand(rawInput: string): void {
    const trimmed = rawInput.trim().toLowerCase();

    // Handle confirmation mode for olvidar/forget
    if (awaitingConfirmation === 'olvidar') {
      awaitingConfirmation = null;
      if (trimmed === 'y' || trimmed === 'yes' || trimmed === 'sí' || trimmed === 'si') {
        clearVisitorState();
        visitorState = createDefaultState();
        showOutput('<p class="output-line output-muted">the garden has forgotten you. it will remember again.</p>');
      } else {
        showOutput('<p class="output-line output-muted">recordando.</p>');
      }
      return;
    }

    const { name, args } = parseCommand(rawInput);

    if (!name) {
      dismissOutput();
      return;
    }

    const handler = commands[name];
    if (handler) {
      // Track command usage
      trackCommand(name);
      visitorState.stats.commandsUsed++;
      trackSecretDiscovery(name);
      saveVisitorState(visitorState);

      handler(args);
    } else {
      if (looksLikeProse(rawInput)) {
        proseRedirect();
      } else {
        showOutput(`<p class="output-line output-muted">unknown command: ${name}</p>`);
      }
    }
  }

  // Event listeners
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      executeCommand(input.value);
    } else if (e.key === 'Escape') {
      dismissOutput();
    }
  });

  // Click anywhere in console to focus input
  visitorsBook?.addEventListener('click', (e) => {
    // Don't steal focus from buttons, links, etc.
    const target = e.target as HTMLElement;
    if (target.tagName === 'BUTTON' || target.tagName === 'A' || target.closest('.season-header')) {
      return;
    }
    input?.focus();
  });

  // Keyboard accessibility for season headers
  output?.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('season-header') && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      target.click();
    }
  });
</script>
