---
/**
 * Dynamic route for journal entries at /cuaderno/[slug]
 * Handles both regular articles and diptych entries.
 */

import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DiptychPage from '../../components/diptych/DiptychPage.astro';
import Garden from '../../layouts/Garden.astro';
import { resolveWikilinks } from '../../lib/resolve-wikilinks.ts';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft);

  return entries.map((entry) => {
    // Astro v6 glob loader uses "folder/index" as id - extract the slug
    const slug = entry.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

interface Props {
  entry: CollectionEntry<'journal'>;
  slug: string;
}

const { entry, slug } = Astro.props;

// Compute series context if entry belongs to a series
interface SeriesContext {
  seriesTitle: string;
  totalParts: number;
  partIndex: number;
  prev?: { slug: string; title: string; partIndex: number };
  next?: { slug: string; title: string; partIndex: number };
}

let seriesContext: SeriesContext | undefined;

if (entry.data.series && entry.data.seriesIndex) {
  // Fetch series manifest
  const seriesManifest = await getEntry('series', entry.data.series);

  if (seriesManifest) {
    // Find all entries in this series
    const allEntries = await getCollection('journal', ({ data }) => !data.draft);
    const seriesEntries = allEntries
      .filter(e => e.data.series === entry.data.series)
      .sort((a, b) => (a.data.seriesIndex ?? 0) - (b.data.seriesIndex ?? 0));

    const currentIndex = seriesEntries.findIndex(e => e.id.replace(/\/index$/, '') === slug);

    const prevEntry = currentIndex > 0 ? seriesEntries[currentIndex - 1] : undefined;
    const nextEntry = currentIndex < seriesEntries.length - 1 ? seriesEntries[currentIndex + 1] : undefined;

    seriesContext = {
      seriesTitle: seriesManifest.data.title,
      totalParts: seriesManifest.data.totalParts,
      partIndex: entry.data.seriesIndex,
      prev: prevEntry ? {
        slug: prevEntry.id.replace(/\/index$/, ''),
        title: prevEntry.data.title,
        partIndex: prevEntry.data.seriesIndex!,
      } : undefined,
      next: nextEntry ? {
        slug: nextEntry.id.replace(/\/index$/, ''),
        title: nextEntry.data.title,
        partIndex: nextEntry.data.seriesIndex!,
      } : undefined,
    };
  }
}
const { type } = entry.data;
const workerUrl = import.meta.env.PUBLIC_VISITORS_WORKER_URL || '';

// For diptych entries, load the sibling markdown files
let articleHtml = '';
let metalogueHtml = '';

if (type === 'diptych') {
  // Import markdown files with Astro's built-in processing
  // The glob returns modules with compiledContent() for HTML output
  const articleModules = import.meta.glob<{ compiledContent: () => string }>(
    '/src/content/journal/**/_article.md',
    { eager: true }
  );
  const metalogueModules = import.meta.glob<{ compiledContent: () => string }>(
    '/src/content/journal/**/_metalogue.md',
    { eager: true }
  );

  // Find the files for this entry's slug
  const articlePath = `/src/content/journal/${slug}/_article.md`;
  const metaloguePath = `/src/content/journal/${slug}/_metalogue.md`;

  const articleModule = articleModules[articlePath];
  const metalogueModule = metalogueModules[metaloguePath];

  if (articleModule?.compiledContent) {
    const raw = await articleModule.compiledContent();
    articleHtml = typeof raw === 'string' ? resolveWikilinks(raw) : '';
  }
  if (metalogueModule?.compiledContent) {
    const raw = await metalogueModule.compiledContent();
    metalogueHtml = typeof raw === 'string' ? resolveWikilinks(raw) : '';
  }
}

// For regular articles, render the content directly
const { Content } = await render(entry);

const pageTitle = `${entry.data.title} — un jardín cibernético`;
const canonicalUrl = `/cuaderno/${slug}/`;

// JSON-LD structured data for regular articles
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "datePublished": entry.data.date.toISOString(),
  "description": entry.data.summary,
  "author": {
    "@type": "Person",
    "name": "Nico"
  },
  "publisher": {
    "@type": "Person",
    "name": "Nico"
  }
});
---

{type === 'diptych' ? (
  <DiptychPage
    entry={entry}
    articleHtml={articleHtml}
    metalogueHtml={metalogueHtml}
    seriesContext={seriesContext}
  />
) : (
  <Garden
    title={pageTitle}
    description={entry.data.summary}
    ogType="article"
    ogImageSlug={slug}
    canonicalUrl={canonicalUrl}
  >
    <script type="application/ld+json" set:html={jsonLd} />
    <main id="main" class="article-page">
      <article>
        <header>
          <h1>{entry.data.title}</h1>
        </header>
        <div class="content">
          <Content />
        </div>
      </article>
    </main>
  </Garden>
)}

<style>
  .article-page {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--rhythm-lg);
  }

  .article-page h1 {
    font-family: var(--font-serif);
    font-size: 1.556rem;
    font-weight: 400;
    margin-bottom: var(--rhythm-lg);
  }

  .content :global(p) {
    font-family: var(--font-serif);
    font-size: 0.944rem;
    line-height: 1.75;
    margin-bottom: var(--rhythm);
    text-align: justify;
  }
</style>

{type !== 'diptych' && (
  <script define:vars={{ workerUrl, slug }}>
    // Article read tracking - only for regular articles (diptych has its own)
    (function() {
      if (!workerUrl || navigator.doNotTrack === '1') return;

      const startTime = Date.now();
      let maxScrollDepth = 0;
      let tracked = false;

      // Get visitor tracking fields
      let vid = null;
      let isDev = false;
      let devId = null;
      try {
        vid = localStorage.getItem('jardin-vid');
        isDev = localStorage.getItem('jardin-dev') === '1';
        if (isDev) {
          devId = localStorage.getItem('jardin-dev-id') || 'unnamed';
        }
      } catch {}

      // Track scroll depth
      function updateScrollDepth() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          const depth = Math.round((scrollTop / docHeight) * 100);
          maxScrollDepth = Math.max(maxScrollDepth, depth);
        }
      }

      window.addEventListener('scroll', updateScrollDepth, { passive: true });
      updateScrollDepth(); // Initial

      // Track on visibility change or unload
      function trackRead() {
        if (tracked) return;
        const readTime = Math.round((Date.now() - startTime) / 1000);
        if (readTime < 10) return; // Only track if >10s spent
        tracked = true;

        try {
          navigator.sendBeacon?.(
            workerUrl + '/track',
            JSON.stringify({
              type: 'article_read',
              path: '/cuaderno/' + slug,
              readTime,
              scrollDepth: maxScrollDepth,
              vid: vid || undefined,
              dev: isDev || undefined,
              devId: isDev ? devId : undefined,
            })
          );

          // Also update local storage for garden stats
          const stored = localStorage.getItem('jardin-visitor');
          if (stored) {
            const state = JSON.parse(stored);
            if (state.stats && !state.stats.articlesRead.includes(slug)) {
              state.stats.articlesRead.push(slug);
              localStorage.setItem('jardin-visitor', JSON.stringify(state));
            }
          }
        } catch {
          // Silently fail
        }
      }

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          trackRead();
        }
      });

      // Fallback for page unload
      window.addEventListener('pagehide', trackRead);
    })();
  </script>
)}

