---
/**
 * /micelio - The mycelium map
 *
 * A force-directed graph visualization of music connections from ahora dispatches.
 * Songs connect where they touched: same dispatch, same tempo, same artist.
 */

import Garden from '../layouts/Garden.astro';
import MyceliumCanvas from '../components/interactive/MyceliumCanvas.astro';
---

<Garden
  title="el micelio | un jardín cibernético"
  description="the invisible network beneath the garden — songs and writings connect where they touched"
  canonicalUrl="/micelio"
>
  <main id="main" class="micelio-page">
    <header class="micelio-header">
      <h1 class="trilingual-title">
        <span class="primary">EL MICELIO</span>
        <span class="separator">·</span>
        <span class="secondary">LE MYCÉLIUM</span>
        <span class="separator">·</span>
        <span class="secondary">THE MYCELIUM</span>
      </h1>
      <p class="intro">
        the invisible network beneath the garden.<br>
        songs and writings connect where they touched.<br>
        drag to pan, scroll to zoom, double-click to reset.
      </p>
    </header>

    <MyceliumCanvas />

    <footer class="micelio-footer">
      <p class="back-link">
        <a href="/#now">← el jardín</a>
      </p>
    </footer>
  </main>
</Garden>

<style>
  .micelio-page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--rhythm-lg);
  }

  .micelio-header {
    text-align: center;
    margin-bottom: var(--rhythm-lg);
  }

  .trilingual-title {
    font-family: var(--font-serif);
    font-size: 0.778rem;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin: 0 0 var(--rhythm) 0;
  }

  .trilingual-title .primary {
    color: var(--ink);
  }

  .trilingual-title .separator {
    color: var(--ink-faint);
    padding: 0 0.5em;
  }

  .trilingual-title .secondary {
    color: var(--ink-faint);
  }

  .intro {
    font-family: var(--font-serif);
    font-size: 0.889rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  .micelio-footer {
    text-align: center;
    margin-top: var(--rhythm-lg);
    padding-top: var(--rhythm);
    border-top: 1px solid var(--paper-line);
  }

  .back-link {
    font-family: var(--font-serif);
    font-size: 0.778rem;
    font-style: italic;
    margin: 0;
  }

  .back-link a {
    color: var(--fern);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
  }
</style>
