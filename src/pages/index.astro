---
import { getCollection, getEntry } from 'astro:content';
import Garden from '../layouts/Garden.astro';
import StationHeader from '../components/chrome/StationHeader.astro';
import SectionHeader from '../components/chrome/SectionHeader.astro';
import Ahora from '../components/cards/Ahora.astro';
import JournalEntry from '../components/cards/JournalEntry.astro';
import SeriesRow from '../components/cards/SeriesRow.astro';
import Cultivation from '../components/cards/Cultivation.astro';
import Specimen from '../components/cards/Specimen.astro';
import SpecimenModal from '../components/interactive/SpecimenModal.astro';
import Library from '../components/interactive/Library.astro';
import VisitorsBook from '../components/interactive/VisitorsBook.astro';

// Fetch collections
const ahoraEntries = (await getCollection('ahora'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const journalEntries = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group journal entries by series
const seriesManifests = await getCollection('series');

// Build series groups and identify standalone entries
type SeriesGroup = {
  type: 'series';
  seriesId: string;
  seriesData: {
    id: string;
    title: string;
    description: string;
    totalParts: number;
    status: 'growing' | 'complete';
  };
  entries: typeof journalEntries;
  latestDate: Date;
};

type StandaloneEntry = {
  type: 'standalone';
  entry: typeof journalEntries[0];
  latestDate: Date;
};

type JournalItem = SeriesGroup | StandaloneEntry;

const seriesGroups = new Map<string, SeriesGroup>();
const standaloneEntries: StandaloneEntry[] = [];

for (const entry of journalEntries) {
  if (entry.data.series) {
    const existing = seriesGroups.get(entry.data.series);
    if (existing) {
      existing.entries.push(entry);
      if (entry.data.date > existing.latestDate) {
        existing.latestDate = entry.data.date;
      }
    } else {
      const manifest = seriesManifests.find(s => s.id === entry.data.series);
      if (manifest) {
        seriesGroups.set(entry.data.series, {
          type: 'series',
          seriesId: entry.data.series,
          seriesData: {
            id: manifest.data.id,
            title: manifest.data.title,
            description: manifest.data.description,
            totalParts: manifest.data.totalParts,
            status: manifest.data.status,
          },
          entries: [entry],
          latestDate: entry.data.date,
        });
      } else {
        // Manifest not found, treat as standalone
        standaloneEntries.push({
          type: 'standalone',
          entry,
          latestDate: entry.data.date,
        });
      }
    }
  } else {
    standaloneEntries.push({
      type: 'standalone',
      entry,
      latestDate: entry.data.date,
    });
  }
}

// Combine and sort by latest date
const journalItems: JournalItem[] = [
  ...Array.from(seriesGroups.values()),
  ...standaloneEntries,
].sort((a, b) => b.latestDate.getTime() - a.latestDate.getTime());

const specimens = (await getCollection('specimens'))
  .sort((a, b) => b.data.grown.getTime() - a.data.grown.getTime());

const cultivations = await getCollection('cultivations');

// Library authors
const libraryAuthors = [
  'Gregory Bateson',
  'Stafford Beer',
  'Humberto Maturana',
  'Gordon Pask',
  'Norbert Wiener',
  'Heinz von Foerster',
];
---

<Garden>
  <main id="main" class="garden">
    <StationHeader />

    <section class="section">
      <SectionHeader slug="now" />
      <div class="section-content">
        <Ahora entries={ahoraEntries} />
      </div>
    </section>

    <section class="section">
      <SectionHeader slug="conservatory" />
      <div class="section-content">
        {specimens.length > 0 ? (
          <div class="specimens-grid">
            {specimens.map((specimen, index) => (
              <Specimen specimen={specimen} index={index} />
            ))}
          </div>
        ) : (
          <p class="empty-state">the conservatory is quiet for now.</p>
        )}
      </div>
    </section>

    <section class="section">
      <SectionHeader slug="journal" />
      <div class="section-content">
        {journalItems.length > 0 ? (
          <div class="journal-entries">
            {journalItems.map((item) =>
              item.type === 'series' ? (
                <SeriesRow
                  series={item.seriesData}
                  entries={item.entries}
                />
              ) : (
                <JournalEntry entry={item.entry} />
              )
            )}
          </div>
        ) : (
          <p class="empty-state">no field notes yet. the pen is somewhere.</p>
        )}
      </div>
    </section>

    <section class="section">
      <SectionHeader slug="cultivations" />
      <div class="section-content">
        {cultivations.length > 0 ? (
          <div class="cultivations-grid">
            {cultivations.map((cultivation) => (
              <Cultivation cultivation={cultivation} />
            ))}
          </div>
        ) : (
          <p class="empty-state">nothing planted yet. soon.</p>
        )}
      </div>
    </section>

    <section class="section">
      <SectionHeader slug="library" />
      <div class="section-content">
        <Library authors={libraryAuthors} />
      </div>
    </section>

    <section class="section">
      <SectionHeader slug="visitors" />
      <div class="section-content">
        <VisitorsBook />
      </div>
    </section>
  </main>

  <!-- Specimen modal for full-size sketch viewing -->
  <SpecimenModal />
</Garden>

<style>
  .garden {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--rhythm-lg);
  }

  .section {
    margin-bottom: 36px;
  }

  .section-content {
    padding: 0;
  }

  .empty-state {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--ink-faint);
    text-align: center;
    padding: var(--rhythm-lg) 0;
  }

  .specimens-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  @media (max-width: 640px) {
    .specimens-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 400px) {
    .specimens-grid {
      grid-template-columns: 1fr;
    }
  }

  .cultivations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 500px) {
    .cultivations-grid {
      grid-template-columns: 1fr;
    }
  }

  .journal-entries {
    max-width: 600px;
    margin: 0 auto;
  }
</style>
