---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageSlug?: string;
  ogType?: 'website' | 'article';
  canonicalUrl?: string;
}

const {
  title = "un jardín cibernético",
  description = "a cybernetic garden — sketches, field notes, and cultivations",
  ogImage,
  ogImageSlug,
  ogType = 'website',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://9scorp4.github.io';
const fullUrl = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl;

// Auto-construct OG image URL from slug, or use explicit ogImage, or fall back to default
let ogImagePath: string;
if (ogImage) {
  ogImagePath = ogImage;
} else if (ogImageSlug) {
  ogImagePath = `/og-images/cuaderno-${ogImageSlug}.png`;
} else {
  ogImagePath = '/og-images/default.png';
}
const fullImageUrl = `${siteUrl}${ogImagePath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- AI training opt-out (defense in depth) -->
    <meta name="robots" content="index, follow, noai, noimageai" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    {canonicalUrl && <link rel="canonical" href={fullUrl} />}

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="un jardín cibernético" href="/feed.xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
