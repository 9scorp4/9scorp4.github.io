# Visitors' Book Configuration
# Copy this file to .env and fill in your values

# Cloudflare Worker URL (PUBLIC_ prefix exposes to client-side)
PUBLIC_VISITORS_WORKER_URL=https://visitors.your-subdomain.workers.dev

# Admin bearer token (generate a secure random string)
VISITORS_ADMIN_TOKEN=your-secret-admin-token

# Cloudflare API credentials (for wrangler and analytics stats)
# Get these from: Cloudflare Dashboard → Manage Account → API Tokens
# Use "Edit Cloudflare Workers" template, add Analytics Engine read access
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Groq API (for bonjour poem generation)
# Get from: https://console.groq.com/keys
# Set as worker secret: wrangler secret put GROQ_API_KEY
GROQ_API_KEY=

# GetSongBPM API (for music-enrich.ts)
# Register at: https://getsongbpm.com/api
# Note: Requires backlink to getsongbpm.com
GETSONGBPM_API_KEY=

# Buffer API (for Instagram publishing via insta-gen.ts)
# Get API key from: https://buffer.com/settings/api
# Get channel ID by running: npm run buffer:channels
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Cloudflare R2 (for hosting Instagram images)
# Uses CF_ACCOUNT_ID from above
# Create bucket at: Cloudflare Dashboard → R2 → Create bucket
# Enable public access for the bucket
# Create API token at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=insta-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev
