# Visitors' Book Configuration
# Copy this file to .env and fill in your values

# Cloudflare Worker URL (PUBLIC_ prefix exposes to client-side)
PUBLIC_VISITORS_WORKER_URL=https://visitors.your-subdomain.workers.dev

# Admin bearer token (generate a secure random string)
VISITORS_ADMIN_TOKEN=your-secret-admin-token

# Cloudflare API credentials (for wrangler and analytics stats)
# Get these from: Cloudflare Dashboard → Manage Account → API Tokens
# Use "Edit Cloudflare Workers" template, add Analytics Engine read access
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# GetSongBPM API (for music-enrich.ts)
# Register at: https://getsongbpm.com/api
# Note: Requires backlink to getsongbpm.com
GETSONGBPM_API_KEY=
